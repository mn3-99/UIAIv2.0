{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MijlAi",
  "version": "1.0.0",
  "identifier": "com.mijlai.chat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MijlAi - Native AI Assistant",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http: https: ws: wss: data: blob: 'unsafe-inline' 'unsafe-eval';"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "MijlAi Ultra-Fast Native AI Chat Application",
    "longDescription": "Cross-Platform Native Chat Application powered by MijlAi engine with offline SQLite persistence, zero-latency streaming, and native desktop/mobile integration.",
    "resources": [],
    "copyright": "© 2026 Mhmod Nemr Alijla",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:mijlai_chat.db"]
    }
  }
}
