# MijlAi Environment Variables Example for Cloudflare Pages Functions
# Copy or set using: wrangler pages secret put <KEY>

GEMINI_API_KEY="your_gemini_api_key_here"
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id_here"
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token_here"
ACCESS_PASSWORD="optional_password_protection_hash"
